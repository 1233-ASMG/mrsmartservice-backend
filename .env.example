# Copia este archivo a .env y rellena valores locales.
# Nunca subas .env ni tokens reales a git.

PORT=8080
NODE_ENV=development

# Front público (links de factura y CORS)
FRONT_URL=http://localhost:3000
# MP exige HTTPS en back_urls con auto_return. En local se usa un fallback HTTPS.
# MP_FRONT_URL=https://tu-front.vercel.app

# Postgres (una de las dos formas)
DATABASE_URL=postgresql://usuario:password@localhost:5432/mrsmartservice
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=mrsmartservice

# Firma de JWT y de tokens de factura. Usa un valor largo y aleatorio.
JWT_SECRET=

# Mercado Pago
# Public key (sí puede ir al front). Access token NUNCA en el front ni en git.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Secreto de webhooks (panel MP → Webhooks). Si está vacío, igual se consulta la API.
MP_WEBHOOK_SECRET=
MP_CURRENCY_ID=COP
# MP_BINARY_MODE=true
# URL pública HTTPS del API para notification_url (Cloud Run, etc.)
PUBLIC_API_URL=http://localhost:8080
# En local, sin credenciales reales:
# MP_MOCK=1

# Envío Villavicencio (el backend ignora el precio que mande el carrito)
SHIPPING_VILLAVICENCIO_COP=7000

# Usuarios de panel solo en desarrollo/test (no en producción)
SEED_DEFAULT_USERS=1

# Uploads (si no hay GCS, se usa ./uploads)
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GCS_CLIENT_EMAIL=
# GCS_PRIVATE_KEY=
# GCS_UPLOAD_FOLDER=mrsmartservice

# SMTP opcional (avisos de venta)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ADMIN_EMAIL=
# ADMIN_EMAILS=

# Licencias (RS256). Genera un par nuevo; no uses claves de ejemplo de internet.
# LICENSE_PRIVATE_KEY=
# LICENSE_PUBLIC_KEY=
# LICENSE_HS_SECRET=
